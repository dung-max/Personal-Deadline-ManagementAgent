# Runtime configuration - never commit real secrets.
# DATABASE_URL takes precedence over DB_* fields (P0.4 rule C). They are never merged.

# Build secret for the internal GitLab PyPI registry (used by `docker compose build`
# via BuildKit secret `gitlab_read_token`). Set in the host environment, not in .env:
#   export GITLAB_READ_TOKEN=your-token-here
# (Do not add GITLAB_READ_TOKEN to .env — an empty value would make the build secret empty.)

DATABASE_URL=postgresql+psycopg2://app:change-me@db:5432/app

# Fallback used only when DATABASE_URL is absent:
# DB_HOST=db
# DB_PORT=5432
# DB_NAME=app
# DB_USER=app
# DB_PASSWORD=change-me

ENVIRONMENT=development

# TODO(MVP): temporary single-user authorization — replace with a real
# user/account + ownership model for multi-user.
# SINGLE_USER_MODE=true authorizes every request (skip check entirely).
# Otherwise only the actor matching DEFAULT_USER_ID is authorized.
# The default DEFAULT_USER_ID below is the local-dev actor.
SINGLE_USER_MODE=false
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001

# PostgreSQL service (docker-compose db)
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

# Scheduler worker (docker-compose scheduler)
SCHEDULER_TICK_SECONDS=60
SCHEDULER_BATCH_SIZE=100

# Phase 5+ (LLM/Agent) - not needed in Phase 1:
# BEDROCK_MODEL_ID=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
